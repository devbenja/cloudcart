# Server
  NODE_ENV=development
  PORT=3001
  LOG_LEVEL=debug
  
  # PostgreSQL
  POSTGRES_HOST=localhost
  POSTGRES_PORT=5432
  POSTGRES_USER=cloudcart
  POSTGRES_PASSWORD=cloudcart_dev_password
  POSTGRES_DB=cloudcart

  # MongoDB
  MONGODB_URI=mongodb://cloudcart:cloudcart_dev_password@localhost:27017/cloudcart
  
  # Redis
  REDIS_HOST=localhost
  REDIS_PORT=6379
  
  # Keycloak
  KEYCLOAK_URL=http://localhost:8180
  KEYCLOAK_REALM=cloudcart
  KEYCLOAK_CLIENT_ID=cloudcart-backend
  KEYCLOAK_CLIENT_SECRET=backend-secret-change-in-production

  # Kafka
  KAFKA_BROKERS=localhost:9092

  # CORS
  CORS_ORIGIN=http://localhost:3000