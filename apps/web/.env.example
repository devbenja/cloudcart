# URL base de la API del backend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Auth (next-auth)
NEXTAUTH_URL=http://localhost:3000
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-32-byte-random-secret

# Keycloak OIDC
KEYCLOAK_ISSUER=http://localhost:8180/realms/cloudcart
KEYCLOAK_CLIENT_ID=cloudcart-frontend
